/* Luminous Void — mockup "Luminous Void" / glass + flat yellow
   Colors from tmp/DESIGN.md  |  canvas #0E0E0E  accent #FFD700 */
QMainWindow {
  background-color: #131313;
  color: #E5E2E1;
}
QWidget {
  color: #E5E2E1;
  background-color: transparent;
}

/* --- Menu bar (glass chrome) --- */
QMenuBar {
  background-color: rgba(32, 31, 31, 220);
  color: #E5E2E1;
  border-bottom: 1px solid rgba(255, 255, 255, 26);
  padding: 2px 12px;
  spacing: 0px;
  min-height: 28px;
}
QMenuBar::item {
  background: transparent;
  color: #D0C6AB;
  padding: 4px 10px;
  margin: 0px 2px;
  border-radius: 4px;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: rgba(255, 255, 255, 18);
  color: #FFF6DF;
}

/* --- Menus --- */
QMenu {
  background-color: #201F1F;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 36);
  border-radius: 6px;
  padding: 2px;
}
QMenu::item {
  background: transparent;
  color: #E5E2E1;
  padding: 5px 12px 5px 8px;
  margin: 0px;
  border-radius: 3px;
  min-height: 20px;
}
QMenu::item:selected {
  background-color: rgba(255, 215, 0, 28);
  color: #FFF6DF;
}
QMenu::item:checked {
  color: #FFD700;
}
QMenu::indicator {
  width: 12px;
  height: 12px;
  left: 6px;
}
QMenu::indicator:checked {
  background-color: #FFD700;
  border-radius: 2px;
}
QMenu::icon {
  left: 4px;
  padding-left: 0px;
}
QMenu::separator {
  height: 1px;
  background: rgba(255, 255, 255, 26);
  margin: 3px 6px;
}

/* --- Toolbar --- */
QToolBar {
  background-color: rgba(28, 27, 27, 230);
  border: none;
  border-bottom: 1px solid rgba(255, 255, 255, 26);
  spacing: 2px;
  padding: 4px 12px;
  min-height: 36px;
}
QToolBar::separator {
  background: rgba(255, 255, 255, 26);
  width: 1px;
  margin: 6px 6px;
}
QToolButton {
  background-color: transparent;
  color: #C8C6C5;
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 5px;
  margin: 0px;
  min-width: 28px;
  min-height: 28px;
}
QToolButton:hover {
  background-color: rgba(255, 255, 255, 14);
  color: #FFF6DF;
}
QToolButton:pressed,
QToolButton:checked {
  background-color: rgba(255, 215, 0, 36);
  border-color: rgba(255, 215, 0, 80);
  color: #FFD700;
}

/* --- Status (yellow accents like mockup) --- */
QStatusBar {
  background-color: #1C1B1B;
  color: #999077;
  border-top: 1px solid rgba(255, 255, 255, 26);
  min-height: 26px;
  padding: 0px 4px;
}
QStatusBar QLabel {
  color: #D0C6AB;
  background: transparent;
  padding: 0px 8px;
  margin: 0px;
}
QStatusBar QLabel#statusAccent {
  color: #FFD700;
}

/* --- Dock / Explorer --- */
QDockWidget {
  color: #E5E2E1;
  titlebar-close-icon: none;
}
QDockWidget::title {
  background-color: #201F1F;
  color: #D0C6AB;
  padding: 10px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 26);
  text-align: left;
  font-weight: 600;
}

/* --- Workspace sidebar (mockup) --- */
QWidget#workspaceSidebar {
  background-color: #201F1F;
  border-right: 1px solid rgba(255, 255, 255, 26);
}
QFrame#sidebarHeader {
  background-color: #1C1B1B;
  border-bottom: 1px solid rgba(255, 255, 255, 14);
}
QLabel#sidebarWorkspaceTitle {
  color: #E5E2E1;
  font-weight: 600;
  font-size: 12px;
}
QLabel#sidebarWorkspaceSub {
  color: #999077;
  font-size: 9px;
  text-transform: uppercase;
}
QLabel#sidebarWorkspaceBadge {
  background-color: rgba(255, 215, 0, 40);
  color: #FFD700;
  border: 1px solid rgba(255, 215, 0, 90);
  border-radius: 12px;
  font-size: 11px;
}
QFrame#sidebarNav {
  background-color: #201F1F;
  border-bottom: 1px solid rgba(255, 255, 255, 14);
}
QPushButton#sidebarNavButton {
  text-align: left;
  padding: 6px 10px;
  border: none;
  border-radius: 4px;
  color: #B7B5B4;
  background: transparent;
}
QPushButton#sidebarNavButton:hover {
  background-color: rgba(255, 255, 255, 12);
  color: #FFF6DF;
}
QPushButton#sidebarNavButton:checked {
  background-color: rgba(255, 255, 255, 14);
  color: #FFD700;
  border: 1px solid rgba(255, 215, 0, 50);
}
QLabel#sidebarSectionLabel {
  color: #999077;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
  padding: 6px 4px 2px 4px;
}
QListWidget#sidebarOpenEditors {
  background-color: transparent;
  border: none;
  outline: none;
  color: #E5E2E1;
}
QListWidget#sidebarOpenEditors::item {
  padding: 4px 6px;
  border-radius: 4px;
  color: #C8C6C5;
}
QListWidget#sidebarOpenEditors::item:selected,
QListWidget#sidebarOpenEditors::item:hover {
  background-color: rgba(255, 215, 0, 28);
  color: #FFD700;
}
QTreeView#sidebarTree {
  background-color: transparent;
  border: none;
  outline: none;
}
QLineEdit#toolbarSearch {
  background-color: #2A2A2A;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 14);
  border-radius: 4px;
  padding: 4px 10px;
  min-height: 18px;
  margin: 0 8px;
}
QLineEdit#toolbarSearch:hover {
  border: 1px solid rgba(255, 215, 0, 80);
  color: #FFF6DF;
}
QDialog#quickOpenDialog {
  background-color: #201F1F;
}
QLineEdit#quickOpenInput {
  background-color: #2A2A2A;
  border: 1px solid #FFD700;
  border-radius: 4px;
  padding: 8px 12px;
  font-size: 13px;
}
QListWidget#quickOpenList {
  background-color: #1C1B1B;
  border: 1px solid rgba(255, 255, 255, 14);
  border-radius: 4px;
}
QListWidget#quickOpenList::item {
  padding: 6px 10px;
}
QListWidget#quickOpenList::item:selected {
  background-color: rgba(255, 215, 0, 40);
  color: #FFF6DF;
}

/* --- Tabs --- */
QTabWidget::pane {
  border: none;
  background-color: #0E0E0E;
  top: 0px;
}
QTabBar {
  background: #1C1B1B;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #999077;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  min-width: 96px;
  padding: 8px 22px 8px 12px;
  margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #0E0E0E;
  color: #FFF6DF;
  border-bottom: 2px solid #FFD700;
}
QTabBar::tab:hover:!selected {
  color: #E5E2E1;
  background-color: rgba(255, 255, 255, 10);
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 6px;
  margin-left: 2px;
  padding: 1px;
}
QToolButton#tabCloseButton:hover {
  background: rgba(255, 255, 255, 18);
}
QToolButton#tabNewButton {
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #999077;
  margin: 2px 6px;
}
QToolButton#tabNewButton:hover {
  background: rgba(255, 215, 0, 28);
  color: #FFD700;
}
QListWidget#settingsNav {
  background: #1C1B1B;
  border: none;
  outline: none;
  padding: 8px 4px;
  color: #999077;
}
QListWidget#settingsNav::item {
  padding: 10px 12px;
  border-radius: 6px;
  margin: 2px 4px;
}
QListWidget#settingsNav::item:selected {
  background: rgba(255, 215, 0, 22);
  color: #FFD700;
}
QListWidget#settingsNav::item:hover:!selected {
  background: rgba(255, 255, 255, 10);
  color: #E5E2E1;
}
QDialog#settingsDialog {
  background: #0E0E0E;
}
QFrame#settingsSep {
  color: #2A2929;
  max-width: 1px;
}

/* --- Editor canvas (deep void) --- */
QPlainTextEdit,
QTextEdit,
QTextBrowser {
  background-color: #0E0E0E;
  color: #E5E2E1;
  border: none;
  selection-background-color: rgba(255, 215, 0, 55);
  selection-color: #FFF6DF;
  padding: 4px 0px;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
  font-size: 12pt;
}

/* Transparent editor variant (property set from code via objectName) */
QPlainTextEdit#translucentEditor,
QAbstractScrollArea#translucentEditor {
  background-color: rgba(14, 14, 14, 180);
}

/* --- Tree --- */
QTreeView {
  background-color: #201F1F;
  color: #E5E2E1;
  border: none;
  outline: none;
  padding: 6px;
}
QTreeView::item {
  min-height: 24px;
  padding: 4px 8px;
  border-radius: 4px;
}
QTreeView::item:hover {
  background-color: rgba(255, 255, 255, 12);
}
QTreeView::item:selected {
  background-color: rgba(255, 215, 0, 40);
  color: #FFF6DF;
  border: 1px solid rgba(255, 215, 0, 90);
}

/* --- Dialogs / settings --- */
QDialog {
  background-color: #201F1F;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 36);
}
QDialog QLabel {
  color: #E5E2E1;
  background: transparent;
}
QLineEdit {
  background-color: #2A2A2A;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 20);
  border-radius: 4px;
  padding: 6px 10px;
  min-height: 18px;
  selection-background-color: rgba(255, 215, 0, 55);
}
QLineEdit:focus {
  border: 1px solid #FFD700;
}
QPushButton {
  background-color: #2A2A2A;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 26);
  border-radius: 4px;
  padding: 6px 14px;
  min-height: 18px;
}
QPushButton:hover {
  background-color: #353534;
  color: #FFF6DF;
}
QPushButton:default,
QPushButton:pressed {
  background-color: #FFD700;
  border-color: #FFD700;
  color: #3A3000;
  font-weight: 600;
}
QCheckBox {
  color: #C8C6C5;
  spacing: 8px;
  padding: 2px 0px;
}
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid #999077;
  background-color: #0E0E0E;
}
QCheckBox::indicator:checked {
  background-color: #FFD700;
  border-color: #FFD700;
}
QSlider::groove:horizontal {
  height: 4px;
  background: #353534;
  border-radius: 2px;
}
QSlider::handle:horizontal {
  width: 14px;
  height: 14px;
  margin: -5px 0;
  background: #FFD700;
  border-radius: 7px;
}
QSlider::sub-page:horizontal {
  background: #E9C400;
  border-radius: 2px;
}
QGroupBox {
  border: 1px solid rgba(255, 255, 255, 26);
  border-radius: 6px;
  margin-top: 12px;
  padding: 12px 10px 10px 10px;
  color: #D0C6AB;
  font-weight: 600;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 6px;
  color: #FFD700;
}
QLabel#findDialogStatus {
  color: #999077;
  padding: 2px 0px;
  min-height: 18px;
}
QListWidget {
  background-color: #1C1B1B;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 20);
  border-radius: 4px;
}
QListWidget::item:selected {
  background-color: rgba(255, 215, 0, 40);
  color: #FFF6DF;
}
QComboBox {
  background-color: #2A2A2A;
  color: #E5E2E1;
  border: 1px solid rgba(255, 255, 255, 20);
  border-radius: 4px;
  padding: 4px 8px;
  min-height: 18px;
}
QComboBox:focus {
  border: 1px solid #FFD700;
}
QComboBox QAbstractItemView {
  background-color: #201F1F;
  color: #E5E2E1;
  selection-background-color: rgba(255, 215, 0, 40);
  border: 1px solid rgba(255, 255, 255, 26);
}

/* --- Splitter / scroll --- */
QSplitter::handle {
  background-color: rgba(255, 255, 255, 18);
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QScrollBar:vertical {
  background: #0E0E0E;
  width: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:vertical {
  background: #353534;
  min-height: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #4D4732; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  height: 0; border: none; background: none;
}
QScrollBar:horizontal {
  background: #0E0E0E;
  height: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:horizontal {
  background: #353534;
  min-width: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  width: 0; border: none; background: none;
}
QToolTip {
  background-color: #2A2A2A;
  color: #FFF6DF;
  border: 1px solid rgba(255, 215, 0, 80);
  padding: 4px 8px;
  border-radius: 4px;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #201F1F;
  border: 1px solid #3A3939;
  border-radius: 8px;
}
QMessageBox QLabel, QDialog#aboutDialog QLabel {
  color: #E5E2E1;
  min-width: 200px;
  max-width: 440px;
  padding: 6px 4px;
}
QLabel#aboutTitle { color: #FFF6DF; font-weight: 600; }
QLabel#aboutMuted { color: #999077; font-size: 10pt; }
QLabel#aboutBody { color: #E5E2E1; }
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #2A2A2A;
  color: #FFF6DF;
  border: 1px solid #403E41;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  background-color: #333333;
  border-color: #FFD700;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(255, 215, 0, 28);
  border: 1px solid #FFD700;
  color: #FFF6DF;
}
