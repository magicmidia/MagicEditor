/* Darcula — JetBrains-like gray + blue accent (dense menus) */
QMainWindow { background-color: #2B2B2B; color: #A9B7C6; }
QWidget { color: #A9B7C6; background-color: transparent; }

QMenuBar {
  background-color: #3C3F41; color: #BBBBBB;
  border-bottom: 1px solid #323232; padding: 2px 6px; spacing: 0px; min-height: 26px;
}
QMenuBar::item {
  background: transparent; color: #BBBBBB;
  padding: 4px 8px; margin: 0px 1px; border-radius: 3px;
}
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #4C5052; color: #FFFFFF; }

QMenu {
  background-color: #3C3F41; color: #BBBBBB;
  border: 1px solid #555555; border-radius: 4px; padding: 2px;
}
QMenu::item {
  background: transparent; color: #BBBBBB;
  padding: 5px 12px 5px 8px; margin: 0px; border-radius: 3px; min-height: 20px;
}
QMenu::item:selected { background-color: #2D65A7; color: #FFFFFF; }
QMenu::item:checked { color: #FFFFFF; }
QMenu::indicator { width: 12px; height: 12px; left: 6px; }
QMenu::indicator:checked { background-color: #6897BB; border-radius: 2px; }
QMenu::icon { left: 4px; }
QMenu::separator { height: 1px; background: #555555; margin: 3px 6px; }

QToolBar {
  background-color: #3C3F41; border: none; border-bottom: 1px solid #323232;
  spacing: 2px; padding: 4px 8px; min-height: 36px;
}
QToolBar::separator { background: #555555; width: 1px; margin: 4px 4px; }
QToolButton {
  background: transparent; color: #A9B7C6; border: 1px solid transparent;
  border-radius: 4px; padding: 5px; min-width: 28px; min-height: 28px;
}
QToolButton:hover { background-color: #4C5052; border-color: #5E6060; }
QToolButton:pressed, QToolButton:checked {
  background-color: #365880; border-color: #4A88C7; color: #FFFFFF;
}

QStatusBar {
  background-color: #3C3F41; color: #878787;
  border-top: 1px solid #323232; min-height: 24px; padding: 0px 4px;
}
QStatusBar QLabel { color: #878787; padding: 0px 8px; }
QStatusBar QLabel#statusAccent { color: #6897BB; }

QDockWidget::title {
  background-color: #3C3F41; color: #BBBBBB;
  padding: 8px 12px; border-bottom: 1px solid #323232; text-align: left;
}
QTabWidget::pane { border: none; background-color: #2B2B2B; }
QTabBar { background: #3C3F41; }
QTabBar::tab {
  background: transparent; color: #878787; border: none;
  border-bottom: 2px solid transparent; border-top-left-radius: 4px;
  border-top-right-radius: 4px; min-width: 88px; padding: 6px 22px 6px 12px; margin-right: 2px;
}
QTabBar::tab:selected { background-color: #2B2B2B; color: #A9B7C6; border-bottom: 2px solid #4A88C7; }
QTabBar::tab:hover:!selected { color: #BBBBBB; background-color: #4C5052; }
QToolButton#tabCloseButton {
  background: transparent; border: none; border-radius: 3px;
  margin-right: 6px; margin-left: 2px; padding: 1px;
}
QToolButton#tabCloseButton:hover { background: rgba(255, 255, 255, 20); }

QPlainTextEdit, QTextEdit, QTextBrowser {
  background-color: #2B2B2B; color: #A9B7C6; border: none;
  selection-background-color: #214283; selection-color: #FFFFFF;
  padding: 4px 0px; font-size: 12pt;
}
QTreeView {
  background-color: #2B2B2B; color: #A9B7C6; border: none; outline: none; padding: 4px;
}
QTreeView::item { min-height: 22px; padding: 3px 6px; border-radius: 3px; }
QTreeView::item:hover { background-color: #3C3F41; }
QTreeView::item:selected { background-color: #2D65A7; color: #FFFFFF; }

QDialog { background-color: #3C3F41; color: #BBBBBB; }
QLineEdit {
  background-color: #2B2B2B; color: #A9B7C6; border: 1px solid #555555;
  border-radius: 4px; padding: 5px 8px; min-height: 16px;
}
QLineEdit:focus { border: 1px solid #4A88C7; }
QPushButton {
  background-color: #4C5052; color: #BBBBBB; border: 1px solid #555555;
  border-radius: 4px; padding: 5px 12px; min-height: 16px;
}
QPushButton:hover { background-color: #5E6060; }
QPushButton:default, QPushButton:pressed {
  background-color: #365880; border-color: #4A88C7; color: #FFFFFF;
}
QCheckBox { color: #BBBBBB; spacing: 8px; }
QCheckBox::indicator {
  width: 14px; height: 14px; border-radius: 3px;
  border: 1px solid #555555; background-color: #2B2B2B;
}
QCheckBox::indicator:checked { background-color: #4A88C7; border-color: #4A88C7; }
QGroupBox {
  border: 1px solid #555555; border-radius: 4px; margin-top: 10px;
  padding: 10px 8px 8px 8px; color: #BBBBBB;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #6897BB; }
QLabel#findDialogStatus { color: #878787; padding: 2px 0px; }
QListWidget {
  background-color: #2B2B2B; color: #A9B7C6; border: 1px solid #555555; border-radius: 4px;
}
QListWidget::item:selected { background-color: #2D65A7; color: #FFFFFF; }
QComboBox {
  background-color: #2B2B2B; color: #A9B7C6; border: 1px solid #555555;
  border-radius: 4px; padding: 4px 8px;
}
QComboBox:focus { border: 1px solid #4A88C7; }
QComboBox QAbstractItemView {
  background-color: #3C3F41; color: #BBBBBB; selection-background-color: #2D65A7;
  border: 1px solid #555555;
}
QSlider::groove:horizontal { height: 4px; background: #555555; border-radius: 2px; }
QSlider::handle:horizontal {
  width: 14px; height: 14px; margin: -5px 0; background: #4A88C7; border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #6897BB; border-radius: 2px; }

QScrollBar:vertical { background: #2B2B2B; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical {
  background: #555555; min-height: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #6B6B6B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  height: 0; border: none; background: none;
}
QScrollBar:horizontal { background: #2B2B2B; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal {
  background: #555555; min-width: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  width: 0; border: none; background: none;
}
QToolTip {
  background-color: #3C3F41; color: #BBBBBB; border: 1px solid #555555;
  padding: 4px 8px; border-radius: 3px;
}
QMessageBox { background-color: #3C3F41; }
QMessageBox, QDialog#aboutDialog { background-color: #3C3F41; border: 1px solid #555; border-radius: 8px; }
QDialog#aboutDialog QLabel { color: inherit; padding: 6px 4px; }
QLabel#aboutTitle { color: #A9B7C6; font-weight: 600; }
QLabel#aboutMuted { color: #878787; font-size: 10pt; }
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px; min-height: 28px; padding: 6px 16px; border-radius: 6px;
  background-color: #4C5052; color: #A9B7C6; border: 1px solid #555;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: #2D65A7; border: 1px solid #4A88C7; color: #FFFFFF;
}

/* --- MagicEditor tab chrome (patched) --- */
QTabWidget {
  background-color: #3C3F41;
}
QTabWidget::pane {
  border: none;
  background-color: #2B2B2B;
  top: 0px;
}
QTabBar {
  background-color: #3C3F41;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #808080;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  min-width: 72px;
  max-width: 220px;
  padding: 3px 12px 3px 10px;
  margin-right: 1px;
  min-height: 18px;
}
QTabBar::tab:selected {
  background-color: #2B2B2B;
  color: #A9B7C6;
  border-bottom: 2px solid #4A88C7;
}
QTabBar::tab:hover:!selected {
  color: #A9B7C6;
  background-color: #4C5052;
}
QTabBar::scroller {
  width: 0px;
}
QTabBar QToolButton {
  background: #3C3F41;
  color: #BBBBBB;
  border: none;
  border-radius: 3px;
  margin: 1px;
}
QToolButton#tabScrollButton {
  background: transparent;
  color: #808080;
  border: none;
  border-radius: 4px;
  font-size: 11px;
  padding: 0px;
}
QToolButton#tabScrollButton:hover {
  background: rgba(74, 136, 199, 40);
  color: #A9B7C6;
}
QToolButton#tabScrollButton:disabled {
  color: #808080;
  opacity: 0.4;
}
QWidget#tabCornerLeft, QWidget#tabCornerRight {
  background-color: #3C3F41;
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 4px;
  margin-left: 1px;
  padding: 1px;
  min-width: 14px;
  min-height: 14px;
}
QToolButton#tabCloseButton:hover {
  background-color: #EF4444;
  border-radius: 3px;
}
QToolButton#tabCloseButton:pressed {
  background-color: #DC2626;
}
QToolButton#tabNewButton {
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #808080;
  margin: 1px 4px;
}
QToolButton#tabNewButton:hover {
  background: rgba(74, 136, 199, 40);
  color: #4A88C7;
}
QDockWidget {
  background-color: #3C3F41;
  color: #A9B7C6;
  border: none;
}
QDockWidget::title {
  background-color: #3C3F41;
  color: #A9B7C6;
  padding: 6px 10px;
  border-bottom: 1px solid #555555;
  text-align: left;
}
QWidget#workspaceSidebar {
  background-color: #3C3F41;
  border-right: 1px solid #555555;
}
QTreeView, QTreeView#sidebarTree {
  background-color: #2B2B2B;
  color: #A9B7C6;
  border: none;
  outline: none;
  padding: 4px;
}
QMessageBox {
  background-color: #3C3F41;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #3C3F41;
  border: 1px solid #555555;
  border-radius: 8px;
}
QMessageBox QLabel { background: transparent; padding: 2px; }
QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgboxextrainfo {
  min-width: 0px;
  max-width: none;
  padding: 4px 8px;
}
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #4C5052;
  color: #BBBBBB;
  border: 1px solid #555555;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  border-color: #4A88C7;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(74, 136, 199, 40);
  border: 1px solid #4A88C7;
  color: #A9B7C6;
}
/* --- end MagicEditor tab chrome --- */

/* confirmDialog */
QDialog#confirmDialog {
  min-width: 420px;
}
QLabel#confirmText {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
}
QLabel#confirmInfo {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
  opacity: 0.9;
}
QLabel#confirmIcon {
  min-width: 48px;
  max-width: 48px;
  padding: 0px;
}
