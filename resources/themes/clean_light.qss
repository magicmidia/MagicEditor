/* Clean Light — zinc neutrals + blue accent */
QMainWindow { background-color: #F8FAFC; color: #0F172A; }
QWidget { color: #0F172A; }
QMenuBar {
  background-color: #FFFFFF; color: #0F172A;
  border-bottom: 1px solid #E2E8F0; padding: 2px 6px; spacing: 0px; min-height: 26px;
}
QMenuBar::item {
  background: transparent; color: #334155;
  padding: 4px 8px; margin: 0px 1px; border-radius: 3px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
  background-color: #F1F5F9; color: #0F172A;
}
QMenu {
  background-color: #FFFFFF; color: #0F172A;
  border: 1px solid #E2E8F0; border-radius: 4px; padding: 2px;
}
QMenu::item {
  background: transparent; color: #0F172A;
  border-radius: 3px;
}
QMenu::item:selected { background-color: #EFF6FF; color: #0F172A; }
QMenu::separator { height: 1px; background: #E2E8F0; margin: 3px 6px; }
QToolBar {
  background-color: #FFFFFF; border: none; border-bottom: 1px solid #E2E8F0;
  spacing: 2px; padding: 1px 8px; min-height: 30px;
}
QToolBar::separator { background: #E2E8F0; width: 1px; margin: 4px 4px; }
QToolButton {
  background: transparent; color: #475569; border: 1px solid transparent;
  border-radius: 4px; padding: 3px; min-width: 24px; min-height: 24px;
}
QToolButton:hover { background-color: #F1F5F9; border-color: #E2E8F0; }
QToolButton:pressed, QToolButton:checked {
  background-color: #DBEAFE; border-color: #93C5FD; color: #1E3A8A;
}
QStatusBar {
  background-color: #FFFFFF; color: #64748B;
  border-top: 1px solid #E2E8F0; min-height: 24px; padding: 0px 4px;
}
QStatusBar QLabel { color: #64748B; padding: 0px 8px; }
QDockWidget::title {
  background-color: #FFFFFF; color: #334155;
  padding: 8px 12px; border-bottom: 1px solid #E2E8F0; text-align: left;
}
QTabWidget::pane { border: none; background-color: #F8FAFC; }
QTabBar { background: #FFFFFF; }
QTabBar::tab {
  background: transparent; color: #64748B; border: none;
  border-bottom: 2px solid transparent; border-top-left-radius: 6px;
  border-top-right-radius: 6px; min-width: 96px; padding: 8px 22px 8px 12px; margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #F8FAFC; color: #0F172A; border-bottom: 2px solid #2563EB;
}
QTabBar::tab:hover:!selected { color: #0F172A; background-color: #F1F5F9; }
QToolButton#tabCloseButton {
  background: transparent; border: none; border-radius: 3px;
  margin-right: 6px; margin-left: 2px; padding: 1px;
}
QToolButton#tabCloseButton:hover { background: rgba(15, 23, 42, 10); }
QPlainTextEdit, QTextEdit, QTextBrowser {
  background-color: #FFFFFF; color: #0F172A; border: none;
  selection-background-color: #BFDBFE; selection-color: #0F172A;
  padding: 4px 0px;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace; font-size: 12pt;
}
QTreeView { background-color: #FFFFFF; color: #0F172A; border: none; padding: 4px; }
QTreeView::item { min-height: 22px; padding: 3px 6px; border-radius: 4px; }
QTreeView::item:hover { background-color: #F1F5F9; }
QTreeView::item:selected { background-color: #DBEAFE; color: #1E3A8A; }
QDialog { background-color: #FFFFFF; color: #0F172A; }
QDialog QLabel { color: #0F172A; background: transparent; }
QMessageBox QLabel { color: #0F172A; background: transparent; }
QLineEdit {
  background-color: #FFFFFF; color: #0F172A; border: 1px solid #CBD5E1;
  border-radius: 6px; padding: 6px 10px; min-height: 18px;
}
QLineEdit:focus { border: 1px solid #2563EB; }
QPushButton {
  background-color: #F1F5F9; color: #0F172A; border: 1px solid #E2E8F0;
  border-radius: 6px; padding: 6px 12px; min-height: 18px;
}
QPushButton:hover { background-color: #E2E8F0; }
QPushButton:default, QPushButton:pressed {
  background-color: #2563EB; border-color: #1D4ED8; color: #FFFFFF;
}
QCheckBox { color: #334155; spacing: 8px; padding: 2px 0px; }
QCheckBox::indicator {
  width: 14px; height: 14px; border-radius: 3px;
  border: 1px solid #94A3B8; background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #2563EB; border-color: #2563EB; }
QLabel#findDialogStatus { color: #64748B; padding: 2px 0px; }
QSplitter::handle { background-color: #E2E8F0; }
QSplitter::handle:horizontal { width: 2px; }
QScrollBar:vertical { background: #F8FAFC; width: 10px; border: none; }
QScrollBar::handle:vertical {
  background: #CBD5E1; min-height: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; border: none; }
QScrollBar:horizontal { background: #F8FAFC; height: 10px; border: none; }
QScrollBar::handle:horizontal {
  background: #CBD5E1; min-width: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; border: none; }
QToolTip {
  background-color: #0F172A; color: #F8FAFC; border: 1px solid #334155;
  padding: 4px 8px; border-radius: 4px;
}
QMessageBox { background-color: #FFFFFF; }
QMessageBox, QDialog#aboutDialog {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
}
QDialog#aboutDialog QLabel { color: #0F172A; padding: 6px 4px; }
QLabel#aboutTitle { color: #0F172A; font-weight: 600; }
QLabel#aboutMuted { color: #64748B; font-size: 10pt; }
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px; min-height: 28px; padding: 6px 16px; border-radius: 6px;
  background-color: #F1F5F9; color: #0F172A; border: 1px solid #E2E8F0;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  background-color: #E2E8F0; border-color: #2563EB;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: #DBEAFE; border: 1px solid #2563EB; color: #1E3A8A;
}

/* --- MagicEditor tab chrome (patched) --- */
QTabWidget {
  background-color: #FFFFFF;
}
QTabWidget::pane {
  border: none;
  background-color: #F8FAFC;
  top: 0px;
}
QTabBar {
  background-color: #FFFFFF;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #64748B;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  min-width: 72px;
  max-width: 220px;
  padding: 3px 12px 3px 10px;
  margin-right: 1px;
  min-height: 18px;
}
QTabBar::tab:selected {
  background-color: #F8FAFC;
  color: #0F172A;
  border-bottom: 2px solid #2563EB;
}
QTabBar::tab:hover:!selected {
  color: #0F172A;
  background-color: #F1F5F9;
}
QTabBar::scroller {
  width: 0px;
}
QTabBar QToolButton {
  background: #FFFFFF;
  color: #334155;
  border: none;
  border-radius: 3px;
  margin: 1px;
}
QToolButton#tabScrollButton {
  background: transparent;
  color: #64748B;
  border: none;
  border-radius: 4px;
  font-size: 11px;
  padding: 0px;
}
QToolButton#tabScrollButton:hover {
  background: rgba(37, 99, 235, 20);
  color: #0F172A;
}
QToolButton#tabScrollButton:disabled {
  color: #64748B;
  opacity: 0.4;
}
QWidget#tabCornerLeft, QWidget#tabCornerRight {
  background-color: #FFFFFF;
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 4px;
  margin-left: 1px;
  padding: 1px;
  min-width: 14px;
  min-height: 14px;
}
QToolButton#tabCloseButton:hover {
  background-color: #EF4444;
  border-radius: 3px;
}
QToolButton#tabCloseButton:pressed {
  background-color: #DC2626;
}
QToolButton#tabNewButton {
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #64748B;
  margin: 1px 4px;
}
QToolButton#tabNewButton:hover {
  background: rgba(37, 99, 235, 20);
  color: #2563EB;
}
QDockWidget {
  background-color: #FFFFFF;
  color: #0F172A;
  border: none;
}
QDockWidget::title {
  background-color: #FFFFFF;
  color: #0F172A;
  padding: 6px 10px;
  border-bottom: 1px solid #E2E8F0;
  text-align: left;
}
QWidget#workspaceSidebar {
  background-color: #FFFFFF;
  border-right: 1px solid #E2E8F0;
}
QTreeView, QTreeView#sidebarTree {
  background-color: #FFFFFF;
  color: #0F172A;
  border: none;
  outline: none;
  padding: 4px;
}
QMessageBox {
  background-color: #FFFFFF;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
}
QMessageBox QLabel { background: transparent; padding: 2px; }
QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgboxextrainfo {
  min-width: 0px;
  max-width: none;
  padding: 4px 8px;
}
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #F1F5F9;
  color: #0F172A;
  border: 1px solid #E2E8F0;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  border-color: #2563EB;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(37, 99, 235, 20);
  border: 1px solid #2563EB;
  color: #0F172A;
}
/* --- end MagicEditor tab chrome --- */

/* confirmDialog */
QDialog#confirmDialog {
  min-width: 420px;
}
QLabel#confirmText {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
}
QLabel#confirmInfo {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
  opacity: 0.9;
}
QLabel#confirmIcon {
  min-width: 48px;
  max-width: 48px;
  padding: 0px;
}
