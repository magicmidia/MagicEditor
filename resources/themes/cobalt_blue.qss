/* Cobalt Blue */
QMainWindow { background-color: #002240; color: #FFFFFF; }
QWidget { color: #FFFFFF; background-color: transparent; }
QMenuBar {
  background-color: #001B33; color: #FFFFFF; border-bottom: 1px solid #003366;
  padding: 4px 6px; min-height: 28px; spacing: 2px;
}
QMenuBar::item { background: transparent; padding: 6px 12px; margin: 1px 2px; border-radius: 6px; }
QMenuBar::item:selected { background-color: #004080; }
QMenu {
  background-color: #001B33; color: #FFFFFF; border: 1px solid #0050A4;
  border-radius: 8px; padding: 6px 4px;
}
QMenu::item { padding: 8px 36px 8px 12px; margin: 2px 4px; border-radius: 6px; min-height: 18px; }
QMenu::item:selected { background-color: #0088FF; }
QMenu::item:checked { background-color: #0050A4; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 6px; }
QMenu::indicator:checked { background: #FFCC66; border-radius: 3px; }
QMenu::separator { height: 1px; background: #003366; margin: 6px 10px; }
QToolBar {
  background-color: #001B33; border: none; border-bottom: 1px solid #003366;
  spacing: 6px; padding: 8px 10px; min-height: 44px;
}
QToolButton {
  background: transparent; color: #FFFFFF; border: 1px solid transparent;
  border-radius: 8px; padding: 8px 10px; min-width: 28px; min-height: 28px;
}
QToolButton:hover { background-color: #004080; border-color: #0050A4; }
QToolButton:checked { background-color: #0088FF; }
QStatusBar {
  background-color: #001B33; color: #80BFFF; border-top: 1px solid #003366;
  min-height: 26px; padding: 2px 6px;
}
QStatusBar QLabel { color: #80BFFF; padding: 2px 10px; }
QDockWidget::title {
  background-color: #001B33; color: #FFFFFF; padding: 10px 12px;
  border-bottom: 1px solid #003366; text-align: left; font-weight: 600;
}
QTabWidget::pane { border: none; background-color: #002240; }
QTabBar::tab {
  background-color: #001B33; color: #80BFFF; border: none;
  border-bottom: 2px solid transparent; border-top-left-radius: 6px;
  border-top-right-radius: 6px; min-width: 110px; padding: 10px 16px; margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #002240; color: #FFFFFF; border-bottom: 2px solid #FFCC66;
}
QTabBar::tab:hover:!selected { background-color: #003366; }
QPlainTextEdit, QTextEdit, QTextBrowser {
  background-color: #002240; color: #FFFFFF; border: none;
  selection-background-color: #0050A4; padding: 8px 4px 8px 0;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace; font-size: 12pt;
}
QTreeView { background-color: #002240; color: #FFFFFF; border: none; padding: 6px; }
QTreeView::item { min-height: 24px; padding: 4px 6px; border-radius: 4px; }
QTreeView::item:hover { background-color: #003366; }
QTreeView::item:selected { background-color: #0088FF; }
QLineEdit {
  background-color: #001B33; color: #FFFFFF; border: 1px solid #0050A4;
  border-radius: 8px; padding: 8px 12px; min-height: 18px;
}
QLineEdit:focus { border: 1px solid #FFCC66; }
QPushButton {
  background-color: #003366; color: #FFFFFF; border: 1px solid #0050A4;
  border-radius: 8px; padding: 8px 14px; min-height: 18px;
}
QPushButton:hover { background-color: #004080; }
QCheckBox { color: #FFFFFF; spacing: 8px; padding: 4px; }
QCheckBox::indicator {
  width: 16px; height: 16px; border-radius: 4px;
  border: 1px solid #0050A4; background: #001B33;
}
QCheckBox::indicator:checked { background: #FFCC66; border-color: #FFCC66; }
QSplitter::handle { background-color: #003366; }
QSplitter::handle:horizontal { width: 3px; }
QScrollBar:vertical { background: #002240; width: 12px; border: none; }
QScrollBar::handle:vertical {
  background: #0050A4; min-height: 36px; border-radius: 5px; margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; border: none; }
QScrollBar:horizontal { background: #002240; height: 12px; border: none; }
QScrollBar::handle:horizontal {
  background: #0050A4; min-width: 36px; border-radius: 5px; margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; border: none; }
#findBar { background-color: #001B33; border-bottom: 1px solid #003366; padding: 4px 0; min-height: 40px; }
#findCount { color: #80BFFF; min-width: 88px; }
QToolTip { background-color: #001B33; color: #FFFFFF; border: 1px solid #0050A4; padding: 6px 10px; }
QMessageBox { background-color: #001B33; }
