/* Cobalt Blue — classic deep blue + yellow (dense menus) */
QMainWindow { background-color: #002240; color: #FFFFFF; }
QWidget { color: #FFFFFF; background-color: transparent; }

QMenuBar {
  background-color: #001B33; color: #FFFFFF;
  border-bottom: 1px solid #0A3D6B; padding: 2px 6px; spacing: 0px; min-height: 26px;
}
QMenuBar::item {
  background: transparent; color: #A8C8E8;
  padding: 4px 8px; margin: 0px 1px; border-radius: 3px;
}
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #0A4A80; color: #FFFFFF; }

QMenu {
  background-color: #001B33; color: #FFFFFF;
  border: 1px solid #0A4A80; border-radius: 4px; padding: 2px;
}
QMenu::item {
  background: transparent; color: #FFFFFF;
  padding: 5px 12px 5px 8px; margin: 0px; border-radius: 3px; min-height: 20px;
}
QMenu::item:selected { background-color: #0A4A80; color: #FFFFFF; }
QMenu::item:checked { color: #FFCC00; }
QMenu::indicator { width: 12px; height: 12px; left: 6px; }
QMenu::indicator:checked { background-color: #FFCC00; border-radius: 2px; }
QMenu::icon { left: 4px; }
QMenu::separator { height: 1px; background: #0A4A80; margin: 3px 6px; }

QToolBar {
  background-color: #001B33; border: none; border-bottom: 1px solid #0A3D6B;
  spacing: 2px; padding: 4px 8px; min-height: 36px;
}
QToolBar::separator { background: #0A4A80; width: 1px; margin: 4px 4px; }
QToolButton {
  background: transparent; color: #A8C8E8; border: 1px solid transparent;
  border-radius: 4px; padding: 5px; min-width: 28px; min-height: 28px;
}
QToolButton:hover { background-color: #0A4A80; border-color: #1A6BB0; color: #FFFFFF; }
QToolButton:pressed, QToolButton:checked {
  background-color: #0A4A80; border-color: #FFCC00; color: #FFCC00;
}

QStatusBar {
  background-color: #001B33; color: #7BA3C9;
  border-top: 1px solid #0A3D6B; min-height: 24px; padding: 0px 4px;
}
QStatusBar QLabel { color: #7BA3C9; padding: 0px 8px; }
QStatusBar QLabel#statusAccent { color: #FFCC00; }

QDockWidget::title {
  background-color: #001B33; color: #A8C8E8;
  padding: 8px 12px; border-bottom: 1px solid #0A3D6B; text-align: left;
}
QTabWidget::pane { border: none; background-color: #002240; }
QTabBar { background: #001B33; }
QTabBar::tab {
  background: transparent; color: #7BA3C9; border: none;
  border-bottom: 2px solid transparent; border-top-left-radius: 4px;
  border-top-right-radius: 4px; min-width: 88px; padding: 6px 22px 6px 12px; margin-right: 2px;
}
QTabBar::tab:selected { background-color: #002240; color: #FFFFFF; border-bottom: 2px solid #FFCC00; }
QTabBar::tab:hover:!selected { color: #FFFFFF; background-color: #0A4A80; }
QToolButton#tabCloseButton {
  background: transparent; border: none; border-radius: 3px;
  margin-right: 6px; margin-left: 2px; padding: 1px;
}
QToolButton#tabCloseButton:hover { background: rgba(255, 255, 255, 25); }

QPlainTextEdit, QTextEdit, QTextBrowser {
  background-color: #002240; color: #FFFFFF; border: none;
  selection-background-color: #0A4A80; selection-color: #FFFFFF;
  padding: 4px 0px; font-size: 12pt;
}
QTreeView {
  background-color: #001F38; color: #FFFFFF; border: none; outline: none; padding: 4px;
}
QTreeView::item { min-height: 22px; padding: 3px 6px; border-radius: 3px; }
QTreeView::item:hover { background-color: #0A3D6B; }
QTreeView::item:selected { background-color: #0A4A80; color: #FFCC00; }

QDialog { background-color: #001B33; color: #FFFFFF; }
QLineEdit {
  background-color: #002240; color: #FFFFFF; border: 1px solid #0A4A80;
  border-radius: 4px; padding: 5px 8px; min-height: 16px;
}
QLineEdit:focus { border: 1px solid #FFCC00; }
QPushButton {
  background-color: #0A4A80; color: #FFFFFF; border: 1px solid #1A6BB0;
  border-radius: 4px; padding: 5px 12px; min-height: 16px;
}
QPushButton:hover { background-color: #1A6BB0; }
QPushButton:default, QPushButton:pressed {
  background-color: #FFCC00; border-color: #FFCC00; color: #002240; font-weight: 600;
}
QCheckBox { color: #A8C8E8; spacing: 8px; }
QCheckBox::indicator {
  width: 14px; height: 14px; border-radius: 3px;
  border: 1px solid #0A4A80; background-color: #002240;
}
QCheckBox::indicator:checked { background-color: #FFCC00; border-color: #FFCC00; }
QGroupBox {
  border: 1px solid #0A4A80; border-radius: 4px; margin-top: 10px;
  padding: 10px 8px 8px 8px; color: #A8C8E8;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #FFCC00; }
QLabel#findDialogStatus { color: #7BA3C9; padding: 2px 0px; }
QListWidget {
  background-color: #002240; color: #FFFFFF; border: 1px solid #0A4A80; border-radius: 4px;
}
QListWidget::item:selected { background-color: #0A4A80; color: #FFCC00; }
QComboBox {
  background-color: #002240; color: #FFFFFF; border: 1px solid #0A4A80;
  border-radius: 4px; padding: 4px 8px;
}
QComboBox:focus { border: 1px solid #FFCC00; }
QComboBox QAbstractItemView {
  background-color: #001B33; color: #FFFFFF; selection-background-color: #0A4A80;
  border: 1px solid #0A4A80;
}
QSlider::groove:horizontal { height: 4px; background: #0A4A80; border-radius: 2px; }
QSlider::handle:horizontal {
  width: 14px; height: 14px; margin: -5px 0; background: #FFCC00; border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #FFCC00; border-radius: 2px; }

QScrollBar:vertical { background: #002240; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical {
  background: #0A4A80; min-height: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #1A6BB0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  height: 0; border: none; background: none;
}
QScrollBar:horizontal { background: #002240; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal {
  background: #0A4A80; min-width: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  width: 0; border: none; background: none;
}
QToolTip {
  background-color: #001B33; color: #FFFFFF; border: 1px solid #FFCC00;
  padding: 4px 8px; border-radius: 3px;
}
QMessageBox { background-color: #001B33; }
QMessageBox, QDialog#aboutDialog { background-color: #002240; border: 1px solid #0A4A80; border-radius: 8px; }
QDialog#aboutDialog QLabel { color: inherit; padding: 6px 4px; }
QLabel#aboutTitle { color: #FFFFFF; font-weight: 600; }
QLabel#aboutMuted { color: #7BA3C9; font-size: 10pt; }
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px; min-height: 28px; padding: 6px 16px; border-radius: 6px;
  background-color: #0A3D6B; color: #FFFFFF; border: 1px solid #0A4A80;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(255, 204, 0, 35); border: 1px solid #FFCC00; color: #FFFFFF;
}

/* --- MagicEditor tab chrome (patched) --- */
QTabWidget {
  background-color: #001B33;
}
QTabWidget::pane {
  border: none;
  background-color: #002240;
  top: 0px;
}
QTabBar {
  background-color: #001B33;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #9EBBD2;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  min-width: 72px;
  max-width: 220px;
  padding: 3px 12px 3px 10px;
  margin-right: 1px;
  min-height: 18px;
}
QTabBar::tab:selected {
  background-color: #002240;
  color: #FFFFFF;
  border-bottom: 2px solid #FFCC00;
}
QTabBar::tab:hover:!selected {
  color: #FFFFFF;
  background-color: #0A4A80;
}
QTabBar::scroller {
  width: 0px;
}
QTabBar QToolButton {
  background: #001B33;
  color: #FFFFFF;
  border: none;
  border-radius: 3px;
  margin: 1px;
}
QToolButton#tabScrollButton {
  background: transparent;
  color: #9EBBD2;
  border: none;
  border-radius: 4px;
  font-size: 11px;
  padding: 0px;
}
QToolButton#tabScrollButton:hover {
  background: rgba(255, 204, 0, 30);
  color: #FFFFFF;
}
QToolButton#tabScrollButton:disabled {
  color: #9EBBD2;
  opacity: 0.4;
}
QWidget#tabCornerLeft, QWidget#tabCornerRight {
  background-color: #001B33;
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 4px;
  margin-left: 1px;
  padding: 1px;
  min-width: 14px;
  min-height: 14px;
}
QToolButton#tabCloseButton:hover {
  background-color: #EF4444;
  border-radius: 3px;
}
QToolButton#tabCloseButton:pressed {
  background-color: #DC2626;
}
QToolButton#tabNewButton {
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #9EBBD2;
  margin: 1px 4px;
}
QToolButton#tabNewButton:hover {
  background: rgba(255, 204, 0, 30);
  color: #FFCC00;
}
QDockWidget {
  background-color: #001B33;
  color: #FFFFFF;
  border: none;
}
QDockWidget::title {
  background-color: #001B33;
  color: #FFFFFF;
  padding: 6px 10px;
  border-bottom: 1px solid #0A4A80;
  text-align: left;
}
QWidget#workspaceSidebar {
  background-color: #001B33;
  border-right: 1px solid #0A4A80;
}
QTreeView, QTreeView#sidebarTree {
  background-color: #002240;
  color: #FFFFFF;
  border: none;
  outline: none;
  padding: 4px;
}
QMessageBox {
  background-color: #002240;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #002240;
  border: 1px solid #0A4A80;
  border-radius: 8px;
}
QMessageBox QLabel { background: transparent; padding: 2px; }
QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgboxextrainfo {
  min-width: 0px;
  max-width: none;
  padding: 4px 8px;
}
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #0A3D6B;
  color: #FFFFFF;
  border: 1px solid #0A4A80;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  border-color: #FFCC00;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(255, 204, 0, 30);
  border: 1px solid #FFCC00;
  color: #FFFFFF;
}
/* --- end MagicEditor tab chrome --- */

/* confirmDialog */
QDialog#confirmDialog {
  min-width: 420px;
}
QLabel#confirmText {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
}
QLabel#confirmInfo {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
  opacity: 0.9;
}
QLabel#confirmIcon {
  min-width: 48px;
  max-width: 48px;
  padding: 0px;
}
