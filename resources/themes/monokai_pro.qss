/* Monokai Pro — warm charcoal + green accent */
QMainWindow { background-color: #2D2A2E; color: #FCFCFA; }
QWidget { color: #FCFCFA; background-color: transparent; }
QMenuBar {
  background-color: #221F22; color: #FCFCFA;
  border-bottom: 1px solid #403E41; padding: 4px 8px; spacing: 0px; min-height: 30px;
}
QMenuBar::item {
  background: transparent; color: #C2C0C4;
  padding: 5px 10px; margin: 0px 2px; border-radius: 4px;
}
QMenuBar::item:selected { background-color: #403E41; color: #FCFCFA; }
QMenu {
  background-color: #221F22; color: #FCFCFA;
  border: 1px solid #5B595C; border-radius: 6px; padding: 4px;
}
QMenu::item {
  padding: 6px 28px 6px 28px; margin: 1px 2px; border-radius: 4px; min-height: 16px;
}
QMenu::item:selected { background-color: #403E41; color: #FCFCFA; }
QMenu::indicator { width: 12px; height: 12px; left: 8px; }
QMenu::indicator:checked { background-color: #A9DC76; border-radius: 2px; }
QMenu::separator { height: 1px; background: #403E41; margin: 4px 8px; }
QToolBar {
  background-color: #221F22; border: none; border-bottom: 1px solid #403E41;
  spacing: 4px; padding: 6px 8px; min-height: 40px;
}
QToolBar::separator { background: #403E41; width: 1px; margin: 4px 6px; }
QToolButton {
  background: transparent; color: #C2C0C4; border: 1px solid transparent;
  border-radius: 6px; padding: 6px; min-width: 30px; min-height: 30px;
}
QToolButton:hover { background-color: #403E41; border-color: #5B595C; }
QToolButton:pressed, QToolButton:checked {
  background-color: #403E41; border-color: #A9DC76; color: #FCFCFA;
}
QStatusBar {
  background-color: #221F22; color: #939293;
  border-top: 1px solid #403E41; min-height: 24px; padding: 0px 4px;
}
QStatusBar QLabel { color: #939293; padding: 0px 8px; }
QDockWidget::title {
  background-color: #221F22; color: #C2C0C4;
  padding: 8px 12px; border-bottom: 1px solid #403E41; text-align: left;
}
QTabWidget::pane { border: none; background-color: #2D2A2E; }
QTabBar { background: #221F22; }
QTabBar::tab {
  background: transparent; color: #939293; border: none;
  border-bottom: 2px solid transparent; border-top-left-radius: 6px;
  border-top-right-radius: 6px; min-width: 96px; padding: 8px 14px; margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #2D2A2E; color: #FCFCFA; border-bottom: 2px solid #A9DC76;
}
QTabBar::tab:hover:!selected { color: #FCFCFA; background-color: #403E41; }
QPlainTextEdit, QTextEdit, QTextBrowser {
  background-color: #2D2A2E; color: #FCFCFA; border: none;
  selection-background-color: #5B595C; selection-color: #FCFCFA;
  padding: 4px 0px;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace; font-size: 12pt;
}
QTreeView { background-color: #2D2A2E; color: #FCFCFA; border: none; padding: 4px; }
QTreeView::item { min-height: 22px; padding: 3px 6px; border-radius: 4px; }
QTreeView::item:hover { background-color: #403E41; }
QTreeView::item:selected { background-color: #5B595C; color: #FCFCFA; }
QDialog { background-color: #221F22; color: #FCFCFA; }
QLineEdit {
  background-color: #2D2A2E; color: #FCFCFA; border: 1px solid #5B595C;
  border-radius: 6px; padding: 6px 10px; min-height: 16px;
}
QLineEdit:focus { border: 1px solid #A9DC76; }
QPushButton {
  background-color: #403E41; color: #FCFCFA; border: 1px solid #5B595C;
  border-radius: 6px; padding: 6px 12px; min-height: 16px;
}
QPushButton:hover { background-color: #5B595C; }
QPushButton:default, QPushButton:pressed {
  background-color: #5B595C; border-color: #A9DC76; color: #FCFCFA;
}
QCheckBox { color: #C2C0C4; spacing: 8px; padding: 2px 0px; }
QCheckBox::indicator {
  width: 14px; height: 14px; border-radius: 3px;
  border: 1px solid #5B595C; background: #2D2A2E;
}
QCheckBox::indicator:checked { background: #A9DC76; border-color: #A9DC76; }
QLabel#findDialogStatus { color: #939293; padding: 2px 0px; }
QSplitter::handle { background-color: #403E41; }
QSplitter::handle:horizontal { width: 2px; }
QScrollBar:vertical { background: #2D2A2E; width: 10px; border: none; }
QScrollBar::handle:vertical {
  background: #5B595C; min-height: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; border: none; }
QScrollBar:horizontal { background: #2D2A2E; height: 10px; border: none; }
QScrollBar::handle:horizontal {
  background: #5B595C; min-width: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; border: none; }
QToolTip {
  background-color: #221F22; color: #FCFCFA; border: 1px solid #5B595C;
  padding: 4px 8px; border-radius: 4px;
}
QMessageBox { background-color: #221F22; }
