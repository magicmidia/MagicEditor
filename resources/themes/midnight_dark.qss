/* Midnight Dark — restrained slate + cyan accent
   Spacing scale: 4 / 8 / 12 / 16  |  see docs/DESIGN.md */
QMainWindow {
  background-color: #0F172A;
  color: #E2E8F0;
}
QWidget {
  color: #E2E8F0;
  }

/* --- Menu bar --- */
QMenuBar {
  background-color: #1E293B;
  color: #E2E8F0;
  border-bottom: 1px solid #334155;
  padding: 2px 6px;
  spacing: 0px;
  min-height: 26px;
}
QMenuBar::item {
  background: transparent;
  color: #CBD5E1;
  padding: 4px 8px;
  margin: 0px 1px;
  border-radius: 3px;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: #334155;
  color: #F8FAFC;
}

/* --- Menus (dense) --- */
QMenu {
  background-color: #1E293B;
  color: #E2E8F0;
  border: 1px solid #334155;
  border-radius: 4px;
  padding: 2px;
}
QMenu::item {
  background: transparent;
  color: #E2E8F0;
  padding: 5px 12px 5px 8px;
  margin: 0px;
  border-radius: 3px;
  min-height: 20px;
}
QMenu::item:selected {
  background-color: #334155;
  color: #F8FAFC;
}
QMenu::item:checked {
  color: #F8FAFC;
}
QMenu::indicator {
  width: 12px;
  height: 12px;
  left: 6px;
}
QMenu::indicator:checked {
  background-color: #22D3EE;
  border-radius: 2px;
}
QMenu::icon {
  left: 4px;
}
QMenu::separator {
  height: 1px;
  background: #334155;
  margin: 3px 6px;
}

/* --- Toolbar --- */
QToolBar {
  background-color: #1E293B;
  border: none;
  border-bottom: 1px solid #334155;
  spacing: 4px;
  padding: 6px 8px;
  min-height: 40px;
}
QToolBar::separator {
  background: #334155;
  width: 1px;
  margin: 4px 6px;
}
QToolButton {
  background-color: transparent;
  color: #CBD5E1;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px;
  margin: 0px;
  min-width: 30px;
  min-height: 30px;
}
QToolButton:hover {
  background-color: #334155;
  border-color: #475569;
}
QToolButton:pressed,
QToolButton:checked {
  background-color: #0E7490;
  border-color: #0891B2;
  color: #ECFEFF;
}

/* --- Status --- */
QStatusBar {
  background-color: #1E293B;
  color: #94A3B8;
  border-top: 1px solid #334155;
  min-height: 24px;
  padding: 0px 4px;
}
QStatusBar QLabel {
  color: #94A3B8;
  background: transparent;
  padding: 0px 8px;
  margin: 0px;
}

/* --- Dock --- */
QDockWidget {
  color: #E2E8F0;
}
QDockWidget::title {
  background-color: #1E293B;
  color: #CBD5E1;
  padding: 8px 12px;
  border-bottom: 1px solid #334155;
  text-align: left;
}

/* --- Tabs --- */
QTabWidget::pane {
  border: none;
  background-color: #0F172A;
  top: 0px;
}
QTabBar {
  background: #1E293B;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #94A3B8;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  min-width: 96px;
  padding: 8px 22px 8px 12px;
  margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #0F172A;
  color: #F1F5F9;
  border-bottom: 2px solid #22D3EE;
}
QTabBar::tab:hover:!selected {
  color: #E2E8F0;
  background-color: #334155;
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 6px;
  margin-left: 2px;
  padding: 1px;
}
QToolButton#tabCloseButton:hover {
  background: rgba(255, 255, 255, 16);
}

/* --- Editor canvas --- */
QPlainTextEdit,
QTextEdit,
QTextBrowser {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
  selection-background-color: #155E75;
  selection-color: #ECFEFF;
  padding: 4px 0px;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
  font-size: 12pt;
}

/* --- Tree --- */
QTreeView {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
  outline: none;
  padding: 4px;
}
QTreeView::item {
  min-height: 22px;
  padding: 3px 6px;
  border-radius: 4px;
}
QTreeView::item:hover {
  background-color: #1E293B;
}
QTreeView::item:selected {
  background-color: #0E7490;
  color: #ECFEFF;
}

/* --- Inputs / buttons (dialogs) --- */
QDialog {
  background-color: #1E293B;
  color: #E2E8F0;
}
QDialog QLabel { color: #E2E8F0; background: transparent; }
QMessageBox QLabel { color: #E2E8F0; background: transparent; }
QLineEdit {
  background-color: #0F172A;
  color: #E2E8F0;
  border: 1px solid #475569;
  border-radius: 6px;
  padding: 6px 10px;
  min-height: 18px;
  selection-background-color: #155E75;
}
QLineEdit:focus {
  border: 1px solid #22D3EE;
}
QPushButton {
  background-color: #334155;
  color: #E2E8F0;
  border: 1px solid #475569;
  border-radius: 6px;
  padding: 6px 12px;
  min-height: 18px;
}
QPushButton:hover {
  background-color: #475569;
}
QPushButton:default,
QPushButton:pressed {
  background-color: #0E7490;
  border-color: #0891B2;
  color: #ECFEFF;
}
QCheckBox {
  color: #CBD5E1;
  spacing: 8px;
  padding: 2px 0px;
}
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid #64748B;
  background-color: #0F172A;
}
QCheckBox::indicator:checked {
  background-color: #22D3EE;
  border-color: #22D3EE;
}
QLabel#findDialogStatus {
  color: #94A3B8;
  padding: 2px 0px;
  min-height: 18px;
}

/* --- Splitter / scroll --- */
QSplitter::handle {
  background-color: #334155;
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QScrollBar:vertical {
  background: #0F172A;
  width: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:vertical {
  background: #475569;
  min-height: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #64748B; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  height: 0; border: none; background: none;
}
QScrollBar:horizontal {
  background: #0F172A;
  height: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:horizontal {
  background: #475569;
  min-width: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  width: 0; border: none; background: none;
}
QToolTip {
  background-color: #1E293B;
  color: #F1F5F9;
  border: 1px solid #475569;
  padding: 4px 8px;
  border-radius: 4px;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #1E293B;
  border: 1px solid #334155;
  border-radius: 8px;
}
QDialog#aboutDialog QLabel { color: #E2E8F0; padding: 6px 4px; }
QLabel#aboutTitle { color: #F1F5F9; font-weight: 600; }
QLabel#aboutMuted { color: #94A3B8; font-size: 10pt; }
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #334155;
  color: #F1F5F9;
  border: 1px solid #475569;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  background-color: #475569;
  border-color: #22D3EE;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(34, 211, 238, 35);
  border: 1px solid #22D3EE;
}

/* --- MagicEditor tab chrome (patched) --- */
QTabWidget {
  background-color: #1E293B;
}
QTabWidget::pane {
  border: none;
  background-color: #0F172A;
  top: 0px;
}
QTabBar {
  background-color: #1E293B;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #94A3B8;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  min-width: 72px;
  max-width: 220px;
  padding: 3px 12px 3px 10px;
  margin-right: 1px;
  min-height: 18px;
}
QTabBar::tab:selected {
  background-color: #0F172A;
  color: #F1F5F9;
  border-bottom: 2px solid #22D3EE;
}
QTabBar::tab:hover:!selected {
  color: #F1F5F9;
  background-color: #334155;
}
QTabBar::scroller {
  width: 0px;
}
QTabBar QToolButton {
  background: #1E293B;
  color: #E2E8F0;
  border: none;
  border-radius: 3px;
  margin: 1px;
}
QToolButton#tabScrollButton {
  background: transparent;
  color: #94A3B8;
  border: none;
  border-radius: 4px;
  font-size: 11px;
  padding: 0px;
}
QToolButton#tabScrollButton:hover {
  background: rgba(34, 211, 238, 30);
  color: #F1F5F9;
}
QToolButton#tabScrollButton:disabled {
  color: #94A3B8;
  opacity: 0.4;
}
QWidget#tabCornerLeft, QWidget#tabCornerRight {
  background-color: #1E293B;
}
QToolButton#tabCloseButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin-right: 4px;
  margin-left: 1px;
  padding: 1px;
  min-width: 14px;
  min-height: 14px;
}
QToolButton#tabCloseButton:hover {
  background-color: #EF4444;
  border-radius: 3px;
}
QToolButton#tabCloseButton:pressed {
  background-color: #DC2626;
}
QToolButton#tabNewButton {
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #94A3B8;
  margin: 1px 4px;
}
QToolButton#tabNewButton:hover {
  background: rgba(34, 211, 238, 30);
  color: #22D3EE;
}
QDockWidget {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
}
QDockWidget::title {
  background-color: #1E293B;
  color: #E2E8F0;
  padding: 6px 10px;
  border-bottom: 1px solid #334155;
  text-align: left;
}
QWidget#workspaceSidebar {
  background-color: #0F172A;
  border-right: 1px solid #334155;
}
QTreeView, QTreeView#sidebarTree {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
  outline: none;
  padding: 4px;
}
QMessageBox {
  background-color: #1E293B;
}
QMessageBox, QDialog#aboutDialog {
  background-color: #1E293B;
  border: 1px solid #334155;
  border-radius: 8px;
}
QMessageBox QLabel { background: transparent; padding: 2px; }
QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgboxextrainfo {
  min-width: 0px;
  max-width: none;
  padding: 4px 8px;
}
QMessageBox QPushButton, QPushButton#aboutOk {
  min-width: 88px;
  min-height: 28px;
  padding: 6px 16px;
  border-radius: 6px;
  background-color: #334155;
  color: #F1F5F9;
  border: 1px solid #475569;
}
QMessageBox QPushButton:hover, QPushButton#aboutOk:hover {
  border-color: #22D3EE;
}
QMessageBox QPushButton:default, QPushButton#aboutOk {
  background-color: rgba(34, 211, 238, 30);
  border: 1px solid #22D3EE;
  color: #F1F5F9;
}
/* --- end MagicEditor tab chrome --- */

/* confirmDialog */
QDialog#confirmDialog {
  min-width: 420px;
}
QLabel#confirmText {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
}
QLabel#confirmInfo {
  min-width: 280px;
  max-width: 480px;
  padding: 0px;
  opacity: 0.9;
}
QLabel#confirmIcon {
  min-width: 48px;
  max-width: 48px;
  padding: 0px;
}
