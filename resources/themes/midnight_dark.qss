/* Midnight Dark — restrained slate + cyan accent
   Spacing scale: 4 / 8 / 12 / 16  |  see docs/DESIGN.md */
QMainWindow {
  background-color: #0F172A;
  color: #E2E8F0;
}
QWidget {
  color: #E2E8F0;
  background-color: transparent;
}

/* --- Menu bar --- */
QMenuBar {
  background-color: #1E293B;
  color: #E2E8F0;
  border-bottom: 1px solid #334155;
  padding: 4px 8px;
  spacing: 0px;
  min-height: 30px;
}
QMenuBar::item {
  background: transparent;
  color: #CBD5E1;
  padding: 5px 10px;
  margin: 0px 2px;
  border-radius: 4px;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: #334155;
  color: #F8FAFC;
}

/* --- Menus (room for check + icon) --- */
QMenu {
  background-color: #1E293B;
  color: #E2E8F0;
  border: 1px solid #334155;
  border-radius: 6px;
  padding: 4px;
}
QMenu::item {
  background: transparent;
  color: #E2E8F0;
  padding: 6px 28px 6px 28px;
  margin: 1px 2px;
  border-radius: 4px;
  min-height: 16px;
}
QMenu::item:selected {
  background-color: #334155;
  color: #F8FAFC;
}
QMenu::item:checked {
  color: #F8FAFC;
}
QMenu::indicator {
  width: 12px;
  height: 12px;
  left: 8px;
}
QMenu::indicator:checked {
  background-color: #22D3EE;
  border-radius: 2px;
}
QMenu::icon {
  padding-left: 6px;
}
QMenu::separator {
  height: 1px;
  background: #334155;
  margin: 4px 8px;
}

/* --- Toolbar --- */
QToolBar {
  background-color: #1E293B;
  border: none;
  border-bottom: 1px solid #334155;
  spacing: 4px;
  padding: 6px 8px;
  min-height: 40px;
}
QToolBar::separator {
  background: #334155;
  width: 1px;
  margin: 4px 6px;
}
QToolButton {
  background-color: transparent;
  color: #CBD5E1;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px;
  margin: 0px;
  min-width: 30px;
  min-height: 30px;
}
QToolButton:hover {
  background-color: #334155;
  border-color: #475569;
}
QToolButton:pressed,
QToolButton:checked {
  background-color: #0E7490;
  border-color: #0891B2;
  color: #ECFEFF;
}

/* --- Status --- */
QStatusBar {
  background-color: #1E293B;
  color: #94A3B8;
  border-top: 1px solid #334155;
  min-height: 24px;
  padding: 0px 4px;
}
QStatusBar QLabel {
  color: #94A3B8;
  background: transparent;
  padding: 0px 8px;
  margin: 0px;
}

/* --- Dock --- */
QDockWidget {
  color: #E2E8F0;
}
QDockWidget::title {
  background-color: #1E293B;
  color: #CBD5E1;
  padding: 8px 12px;
  border-bottom: 1px solid #334155;
  text-align: left;
}

/* --- Tabs --- */
QTabWidget::pane {
  border: none;
  background-color: #0F172A;
  top: 0px;
}
QTabBar {
  background: #1E293B;
  qproperty-drawBase: 0;
}
QTabBar::tab {
  background-color: transparent;
  color: #94A3B8;
  border: none;
  border-bottom: 2px solid transparent;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  min-width: 96px;
  padding: 8px 14px;
  margin-right: 2px;
}
QTabBar::tab:selected {
  background-color: #0F172A;
  color: #F1F5F9;
  border-bottom: 2px solid #22D3EE;
}
QTabBar::tab:hover:!selected {
  color: #E2E8F0;
  background-color: #334155;
}

/* --- Editor canvas --- */
QPlainTextEdit,
QTextEdit,
QTextBrowser {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
  selection-background-color: #155E75;
  selection-color: #ECFEFF;
  padding: 4px 0px;
  font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
  font-size: 12pt;
}

/* --- Tree --- */
QTreeView {
  background-color: #0F172A;
  color: #E2E8F0;
  border: none;
  outline: none;
  padding: 4px;
}
QTreeView::item {
  min-height: 22px;
  padding: 3px 6px;
  border-radius: 4px;
}
QTreeView::item:hover {
  background-color: #1E293B;
}
QTreeView::item:selected {
  background-color: #0E7490;
  color: #ECFEFF;
}

/* --- Inputs / buttons (dialogs) --- */
QDialog {
  background-color: #1E293B;
  color: #E2E8F0;
}
QLineEdit {
  background-color: #0F172A;
  color: #E2E8F0;
  border: 1px solid #475569;
  border-radius: 6px;
  padding: 6px 10px;
  min-height: 16px;
  selection-background-color: #155E75;
}
QLineEdit:focus {
  border: 1px solid #22D3EE;
}
QPushButton {
  background-color: #334155;
  color: #E2E8F0;
  border: 1px solid #475569;
  border-radius: 6px;
  padding: 6px 12px;
  min-height: 16px;
}
QPushButton:hover {
  background-color: #475569;
}
QPushButton:default,
QPushButton:pressed {
  background-color: #0E7490;
  border-color: #0891B2;
  color: #ECFEFF;
}
QCheckBox {
  color: #CBD5E1;
  spacing: 8px;
  padding: 2px 0px;
}
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid #64748B;
  background-color: #0F172A;
}
QCheckBox::indicator:checked {
  background-color: #22D3EE;
  border-color: #22D3EE;
}
QLabel#findDialogStatus {
  color: #94A3B8;
  padding: 2px 0px;
  min-height: 16px;
}

/* --- Splitter / scroll --- */
QSplitter::handle {
  background-color: #334155;
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QScrollBar:vertical {
  background: #0F172A;
  width: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:vertical {
  background: #475569;
  min-height: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #64748B; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  height: 0; border: none; background: none;
}
QScrollBar:horizontal {
  background: #0F172A;
  height: 10px;
  margin: 0;
  border: none;
}
QScrollBar::handle:horizontal {
  background: #475569;
  min-width: 28px;
  border-radius: 4px;
  margin: 2px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  width: 0; border: none; background: none;
}
QToolTip {
  background-color: #1E293B;
  color: #F1F5F9;
  border: 1px solid #475569;
  padding: 4px 8px;
  border-radius: 4px;
}
QMessageBox {
  background-color: #1E293B;
}
QMessageBox QLabel {
  color: #E2E8F0;
  min-width: 260px;
}
