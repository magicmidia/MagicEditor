# Git worktrees
.worktrees/
worktrees/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
.env.*
!.env.example
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local / temp / scratch
tmp/
*.log
*.tmp
*.bak
*.orig

# Host-local agent/MCP secrets (keep examples)
.mcp.json
*.local.md

# ---------------------------------------------------------------------------
# Packaging / release artifacts (never commit binaries)
# ---------------------------------------------------------------------------
# PyInstaller / setuptools
build/
dist/
*.spec.bak

# Windows binaries and installers
*.exe
*.msi
*-setup.exe
*.msix
*.appx
*.msixbundle
*.cab
*.msm
*.msp

# Portable / archives produced by scripts/build.ps1
*.zip
!resources/**/*.zip

# Staging for MSI / portable
out/
release/
installer/stage/
packaging/stage/

# WiX intermediate objects
*.wixobj
*.wixpdb
*.cab
packaging/wix/*.wixobj
packaging/wix/*.wixpdb

# Optional native installers from other tools
*.iss.bak
Output/

# PyInstaller onedir leftovers if run from root.
# Do NOT use a bare "MagicEditor/" pattern: on Windows (case-insensitive)
# it matches this repo folder (magicEditor) and hides new source files.
/MagicEditor/base_library.zip
/MagicEditor/*.pkg
/MagicEditor/MagicEditor.exe
